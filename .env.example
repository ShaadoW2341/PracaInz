POSTGRES_DB=mycomap
POSTGRES_USER=mycomap
POSTGRES_PASSWORD=local_change_me
POSTGRES_PORT=5432
# Maven nie wczytuje automatycznie .env; application.yml ma lokalne wartości domyślne.
DB_URL=jdbc:postgresql://localhost:5432/mycomap
DB_USERNAME=mycomap
DB_PASSWORD=local_change_me
SESSION_COOKIE_SECURE=false
# SMTP lokalnie: skrzynka http://127.0.0.1:8025 (wiadomości nie wychodzą do internetu).
# Dla backendu uruchomionego w Dockerze ustaw MAIL_HOST=mailpit.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_SSL=false
MAIL_FROM=no-reply@mycomap.local
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_AUTH=true,
# MAIL_STARTTLS=true, MAIL_SSL=false. Adres wpisz w MAIL_USERNAME i MAIL_FROM.
# Hasło aplikacji Google wpisz wyłącznie do lokalnego .env jako MAIL_PASSWORD.
APP_PUBLIC_URL=http://127.0.0.1:5173
# URL stylu MapLibre od wybranego dostawcy (uwzględnij jego licencję i limity).
# Puste pole oznacza jawny brak podkładu; aplikacja nie korzysta automatycznie z OSM.
VITE_MAP_STYLE_URL=
